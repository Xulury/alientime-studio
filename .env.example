# Alien Time Listing Studio — configuration template.
# Copy to .env and fill in what you have. Names only here; never commit real values.
# Everything is optional except where marked. Unset integrations stay "Not configured".
# Recommended: keep secrets in your password manager and inject them at start
# (1Password: `op run --env-file=.env -- uvicorn app.main:app`), so only OP_SERVICE_ACCOUNT_TOKEN lives on disk.

# ---- Password manager (optional) ---------------------------------------------------------------
OP_SERVICE_ACCOUNT_TOKEN=

# ---- Application -------------------------------------------------------------------------------
STUDIO_ENV=development
# Where the database, private photos and exports live (default: ./data)
STUDIO_DATA_DIR=
# PostgreSQL in production, e.g. postgresql+psycopg://user:pass@host/studio (default: SQLite in the data dir)
DATABASE_URL=
# The address you open in the browser (used in Telegram review links)
STUDIO_BASE_URL=http://127.0.0.1:8000
# Set to true when served over HTTPS (Cloudflare Tunnel/Access, reverse proxy)
STUDIO_COOKIE_SECURE=false
STUDIO_SESSION_HOURS=12
# First-account setup is only allowed from this computer unless one of these is set
STUDIO_ALLOW_REMOTE_SETUP=false
STUDIO_SETUP_TOKEN=
STUDIO_LOG_LEVEL=INFO
STUDIO_LOG_JSON=true

# ---- Uploads and processing --------------------------------------------------------------------
MAX_UPLOAD_MB=30
MAX_FILES_PER_UPLOAD=40
WORKING_MAX_EDGE=4000
# thread = worker inside the web process; external = run `python -m app.jobs.worker` separately
WORKER_MODE=thread
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
AUTO_PROCESS_UPLOADS=true
# auto | rapidocr | none
OCR_BACKEND=auto
OCR_MAX_EDGE=2560
# auto | rembg | grabcut   (rembg downloads the model once, ~180 MB for isnet-general-use)
SEGMENTATION_BACKEND=auto
# isnet-general-use (default), birefnet-general, birefnet-general-lite, u2net
REMBG_MODEL=isnet-general-use
REMBG_MODEL_DIR=

# ---- OpenAI (Phase 1) --------------------------------------------------------------------------
# auto = OpenAI when OPENAI_API_KEY is set, otherwise AI features are off. mock = offline test mode.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_BASE_URL=
# Model identifiers (checked against OpenAI's model list on 2026-10-18)
OPENAI_MODEL_VISION=gpt-6.1-sol
OPENAI_MODEL_INTEL=gpt-6.1-sol
OPENAI_MODEL_TEXT=gpt-6.1-sol
OPENAI_MODEL_IMAGE=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=3
# Spending limits enforced by the studio (also set a monthly limit on the OpenAI project itself)
AI_DAILY_BUDGET_USD=10
AI_MONTHLY_BUDGET_USD=100
# reviewed_only (default) | safe_auto | never — which photos may be sent to cloud AI
CLOUD_AI_IMAGE_POLICY=reviewed_only
# plate (default: text-only backdrop, no photo sent) | context_edit
AI_BACKGROUND_MODE=plate

# ---- Publishing --------------------------------------------------------------------------------
# Lets channels that are not connected run in clearly labelled simulation (nothing is posted)
ENABLE_SIMULATED_PUBLISHING=true
# Comma-separated channels whose simulation should fail (testing only)
MOCK_PUBLISH_FAIL_CHANNELS=

# ---- Telegram / Hermes (Phase 0) ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Telegram user IDs allowed to approve, publish and mark sold through Hermes (comma-separated)
TELEGRAM_ADMIN_USERS=
TELEGRAM_NOTIFY_CHAT_ID=

# ---- Google Drive + Sheets (Phase 0) -----------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=
DRIVE_ROOT_FOLDER_ID=
FACTS_SHEET_ID=
FACTS_SHEET_RANGE=A1:Z1000

# ---- GitHub (Phase 0, used by you, not the app) ------------------------------------------------
GITHUB_TOKEN=

# ---- Cloudflare Pages + Access (Phase 2) / R2 (Phase 3) ----------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT_URL=

# ---- Shopify (Phase 3) -------------------------------------------------------------------------
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# ---- Meta: Instagram + Facebook Page (Phase 3) -------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_GRAPH_VERSION=v24.0
IG_USER_ID_ALIENTIME_SG=
IG_USER_ID_OFFICIAL=
FB_PAGE_ID=

# ---- Chrono24 (Phase 3) ------------------------------------------------------------------------
CHRONO24_FEED_URL=

# ---- eBay, optional (Phase 3) ------------------------------------------------------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_REFRESH_TOKEN=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CATEGORY_ID=31387
EBAY_ENVIRONMENT=production

# ---- WhatsApp Cloud API, optional (Phase 4) ----------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
